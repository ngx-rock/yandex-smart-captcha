{
  "name": "@ngx-rock/yandex-smart-captcha",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/yandex-smart-captcha/src",
  "prefix": "lib",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["dist/{projectRoot}"]
    }
  },
  "tags": [],
  "targets": {
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "options": {
        "configDir": ".storybook",
        "browserTarget": "@ngx-rock/yandex-smart-captcha:build-storybook",
        "tsConfig": ".storybook/tsconfig.json",
        "port": 6006,
        "compodoc": false
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "configDir": ".storybook",
        "tsConfig": ".storybook/tsconfig.json",
        "outputDir": "dist/storybook",
        "compodoc": false
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/yandex-smart-captcha/ng-package.json",
        "tsConfig": "libs/yandex-smart-captcha/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/yandex-smart-captcha/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
